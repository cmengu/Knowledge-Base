# Python virtual environment (per-worktree venv)
.venv/
venv/

# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ingest output / local data stores (SQLite lives here; canonical data is re-derivable)
data/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# OS / editor cruft
.DS_Store

# Per-run digest output surface (ticket #10). Digests are generated artifacts written on
# every run; the committed eyeball sample lives under fixtures/digest-sample/ instead.
digests/
